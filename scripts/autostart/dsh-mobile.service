# systemd user unit — starts the resident dsh mobile service at login.
# Install: mkdir -p ~/.config/systemd/user && cp this file there, then
#   systemctl --user daemon-reload && systemctl --user enable --now dsh-mobile.service
# Edit ExecStart to your dsh path (`which dsh`) if it is not /usr/local/bin/dsh.
[Unit]
Description=DeepSeek Harness mobile resident service
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/dsh --profile mobile service start
RemainAfterExit=no

[Install]
WantedBy=default.target
