<?xml version="1.0" encoding="UTF-8"?>
<!-- Windows Task Scheduler — starts the resident dsh mobile service at logon.
     Install: schtasks /Create /TN "dsh-mobile" /XML scripts\autostart\dsh-mobile-task.xml
     Edit the dsh path (Command) if your npm global bin differs. -->
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>DeepSeek Harness mobile resident service</Description>
  </RegistrationInfo>
  <Triggers>
    <LogonTrigger>
      <Enabled>true</Enabled>
    </LogonTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <StartWhenAvailable>true</StartWhenAvailable>
    <Enabled>true</Enabled>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>C:\Users\%USERNAME%\AppData\Roaming\npm\dsh.cmd</Command>
      <Arguments>--profile mobile service start</Arguments>
    </Exec>
  </Actions>
</Task>
